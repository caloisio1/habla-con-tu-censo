# .env.example — configuración de "Habla con tu Censo".
#
# Copiar a .env y completar OPENAI_API_KEY. El .env real NO va al repo
# (.gitignore:3); este ejemplo existe para que la configuración de modelos y topes
# quede EN EL TAG y no dependa de un .bak en el server.
#
# Valores de la configuración del piloto (tag piloto-configD-20260914 en adelante).

# --- clave -------------------------------------------------------------------
# La única línea que no se versiona. Nunca pegar la clave acá.
OPENAI_API_KEY=

# --- mapa base (CARTO) -------------------------------------------------------
# Clave gratuita de carto.com/basemaps/apikey. Viaja en la URL de las teselas (es
# visible en el navegador), pero igual no se versiona. Vacía: el mapa se dibuja
# con la marca de agua "API KEY REQUIRED".
CARTO_BASEMAP_KEY=

# --- base de datos -----------------------------------------------------------
CENSO2023_DB=/root/censo-query-uy/datos/censo2023.db

# --- modelos por etapa (Config D, desplegada el 14-sep-2026) -----------------
# El SQL NO se baja de gpt-5.5: gpt-5.4 rompía el total de población de 2023 de
# forma NO DETERMINISTA (sobre-filtraba con NOT ... IS NULL). El redactor solo
# narra, así que va en mini: -77 % en esa etapa, con batería AB VERDE (155/0).
CENSO_MODELO_SQL=gpt-5.5
CENSO_MODELO_REDACTOR=gpt-5.4-mini

# --- esfuerzo de razonamiento por etapa --------------------------------------
# El SQL razona (traducir la pregunta al esquema es el paso difícil); el redactor
# no. Ojo: el razonamiento sale del MISMO cupo que el texto, así que bajar los
# topes sin volver a medir deja respuestas VACÍAS por corte.
CENSO_ESFUERZO_SQL=high
CENSO_ESFUERZO_REDACTOR=low

# --- tope de gasto (fail-closed) ---------------------------------------------
# En USD. Al alcanzarlos NO se llama al modelo y se le explica al usuario cuándo
# se renueva la cuota. El día y el mes son los de Montevideo, no UTC.
# La caché sigue respondiendo por encima del tope (comun/presupuesto.py).
# CENSO_TOPE=0 lo desactiva por completo.
CENSO_TOPE_USD_MES=300
CENSO_TOPE_USD_DIA=25

# --- opcionales (valores por defecto entre paréntesis) -----------------------
# CENSO_TOPE=1                  (1) tope de gasto activo
# CENSO_PRECALENTAR=1           (1) calienta la caché con los chips al arrancar
# CENSO_CACHE_TTL=21600         (6 h) vigencia de la caché de respuestas
# CENSO_CACHE_MAX=500           (500) entradas máximas de la caché
# CENSO_LLM_TIMEOUT=60          (60 s) tope por llamada al modelo
